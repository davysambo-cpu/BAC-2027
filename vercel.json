{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run db:migrate && npm run catalogue:import && npm run pilot:seed && npm run build:serverless && npm run build --workspace @bac-2027/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 30,
      "includeFiles": "node_modules/argon2/prebuilds/**"
    },
    "api/runtime-diagnostic.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/argon2/prebuilds/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/[...path].mjs" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
