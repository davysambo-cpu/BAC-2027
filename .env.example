# Runtime
NODE_ENV=development
HOST=0.0.0.0
API_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info

# Database
# Use pglite for dependency-free local development and postgres in production.
DATABASE_DRIVER=pglite
DATABASE_URL=postgresql://bac2027:bac2027_dev@localhost:5432/bac2027
PGLITE_DATA_DIR=../../.data/pglite

# Authentication — replace AUTH_TOKEN_SECRET in every deployed environment
AUTH_TOKEN_SECRET=bac-2027-development-token-secret-change-me
SESSION_COOKIE_NAME=bac2027_session
# Development only: allows Arena's cookie-blocking embedded preview.
EMBEDDED_PREVIEW_MODE=false
INVITATION_TTL_HOURS=72
RESET_CODE_TTL_MINUTES=30
PERSONAL_SESSION_TTL_DAYS=30
SHARED_SESSION_TTL_HOURS=8

# Revision horizon — the month is a planning objective, not an asserted exam date.
REVISION_TARGET_MONTH=2027-07

# Media storage — filesystem is development-only; production requires s3.
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_STORAGE_DIR=../../.data/uploads
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=bac-2027-dev
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Configurable pilot limits
DEFAULT_USER_STORAGE_QUOTA_MB=250
MAX_DOCUMENT_SIZE_MB=25
MAX_IMAGE_SIZE_MB=5
MAX_AUDIO_SIZE_MB=10
MAX_VIDEO_SIZE_MB=150
MAX_DAILY_REPORT_IMAGES=2
MAX_DAILY_REPORT_AUDIO=1

# Demo seed is always forbidden in production
SEED_DEMO_DATA=false
